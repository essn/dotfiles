{
  "extends": [
    "opencode"
  ],
  "meta": {
    "name": "opencode-local",
    "version": "",
    "description": "OpenCode plus mise access",
    "author": "jesse"
  },
  "groups": {
    "include": [
      "mise_manager"
    ]
  },
  "filesystem": {
    "allow": [],
    "read": [
      "$HOME/.local/share/mise/installs",
      "~/.claude",
      "~/.claude/ide",
      "~/.claude/skills"
    ],
    "read_file": [
      "~/.config/git/local"
    ],
    "deny": [
      "/System"
    ],
    "suppress_save_prompt": [
      "/System",
      "/Users"
    ]
  }
}
