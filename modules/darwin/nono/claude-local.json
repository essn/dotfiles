{
  "extends": [
    "claude"
  ],
  "meta": {
    "name": "claude-local",
    "version": "",
    "description": "Claude Code plus mise access",
    "author": "jesse"
  },
  "groups": {
    "include": [
      "mise_manager"
    ]
  },
  "filesystem": {
    "read": [
      "$HOME/.local/share/mise/installs",
      "~/dotfiles"
    ],
    "read_file": [
      "~/dotfiles/modules/claude/CLAUDE.md",
      "~/.config/git/local"
    ],
    "deny": [
      "/System"
    ],
    "bypass_protection": [],
    "suppress_save_prompt": [
      "~/code",
      "/System",
      "/Users",
      "~/"
    ]
  }
}
