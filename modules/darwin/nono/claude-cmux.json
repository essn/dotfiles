{
  "extends": [
    "claude"
  ],
  "meta": {
    "name": "claude-cmux",
    "description": "Claude Code plus access to the cmux control socket, for orchestrating other cmux panes",
    "author": "jesse"
  },
  "groups": {
    "include": [
      "mise_manager"
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.local/state/cmux"
    ],
    "read": [
      "$HOME/.local/share/mise/installs"
    ]
  },
  "environment": {
    "set_vars": {
      "CMUX_AGENT_LAUNCH_KIND": "claude",
      "CMUX_AGENT_LAUNCH_EXECUTABLE": "/opt/homebrew/bin/nono",
      "CMUX_AGENT_LAUNCH_ARGV_B64": "L29wdC9ob21lYnJldy9iaW4vbm9ubwBydW4ALS1wcm9maWxlAGNsYXVkZS1jbXV4AC0tAGNsYXVkZQA=",
      "CMUX_AGENT_LAUNCH_CWD": "$WORKDIR"
    }
  }
}
